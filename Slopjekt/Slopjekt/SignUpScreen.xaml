<Window x:Class="Slopjekt.SignUpScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Slopjekt"
        mc:Ignorable="d"
        Title="SignUpScreen" Height="450" Width="800">
    <Grid>
        <Grid.Effect>
            <BlurEffect Radius="2"></BlurEffect>
        </Grid.Effect>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition><!-- ^.^ BCAS --></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="1">
            <TextBlock Text="SIGNUP" FontSize="50" TextAlignment="Center"></TextBlock>
            <TextBlock Text="Username:" TextAlignment="Center"></TextBlock>
            <TextBox Name="UserNameInputBox"></TextBox>
            <TextBlock Text="Password:" TextAlignment="Center"></TextBlock>
            <PasswordBox Name="UserPasswordInputBox"></PasswordBox>
            <TextBlock Text="Confirm Password:" TextAlignment="Center"></TextBlock>
            <PasswordBox Name="UserPasswordConfirmInputBox"></PasswordBox>
            <StackPanel Orientation="Vertical" Margin="0 25 0 0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Promo Code" ToolTip="Entering codes allows you to start with modified equipment."></TextBlock>
                    <TextBox Name="PromoCodeInputBox" Width="75"></TextBox>
                    <TextBlock Name="PromoCodeFeedbackTB" Foreground="Red" Text="Code not found."></TextBlock>
                </StackPanel>
                <Button Content="Apply Code" Width="75"></Button>
            </StackPanel>
            <TextBlock Text="Already have an account? Log in!" Foreground="Blue" TextDecorations="Underline" TextAlignment="Center" FontSize="9" Cursor="Hand"></TextBlock>
            <TextBlock Name="FeedbackTB" Margin="0 15 0 0" Foreground="Red" Text="All fields must be filled!" TextAlignment="Center"></TextBlock>
            <Button Content="Sign Up" Width="75"></Button>
        </StackPanel>
    </Grid>
    
</Window>
