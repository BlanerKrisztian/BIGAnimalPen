<Window x:Class="Slopjekt.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Slopjekt"
        mc:Ignorable="d"
        Title="Profile" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        
        <Label Content="MENU"></Label>
        <StackPanel Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal">
            <Button Content="Inventory" Margin="5 0 0 0"></Button>
            <Button Content="Shop" Margin="5 0 0 0"></Button>
            <Button Content="Friends" Margin="5 0 0 0"></Button>
            <Button Content="Habitats" Margin="5 0 0 0"></Button>
            <Button Content="Upgrades" Margin="5 0 0 0"></Button>
            <Button Content="Achievements" Margin="5 0 0 0"></Button>
            <Button Content="Stats" Margin="5 0 0 0"></Button>
            <TextBlock Text="Resources:" Width="250"></TextBlock>
        </StackPanel>
        
        
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Image Source="/PFPs/Schlep_profile_picture.jpg"/>
            <StackPanel Grid.Row="1">
                
                <TextBlock Name="ProfileNameTB" Text="ProfileName"></TextBlock>
                <TextBlock Name="ProfileLevelTB" Text="1.lvl"></TextBlock>
                <ProgressBar Name="ProfileLevelPB" Height="5" Value="87"></ProgressBar>
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="2" Grid.Column="1" Grid.RowSpan="5">
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Events"></TextBlock>
                <StackPanel>
                    <TextBlock Text="ExampleGecko grew up." FontSize="9"></TextBlock>
                    <TextBlock Text="ExampleFish waterquality 20%."  FontSize="9"></TextBlock>
                    <TextBlock Text="Tier3 gecko plapen sold!"  FontSize="9"></TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="2" Grid.Column="0" Grid.RowSpan="5">
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Online Friends"></TextBlock>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PFPs/Schlep_profile_picture.jpg" MaxHeight="30" MaxWidth="30"/>
                        <StackPanel>
                            <TextBlock Text="ExampleFriend" FontSize="9"></TextBlock>
                            <TextBlock Name="ExampleFriendStatus" Text="Online" FontSize="7" Foreground="Green"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Image Source="/PFPs/Schlep_profile_picture.jpg" MaxHeight="30" MaxWidth="30"/>
                        <StackPanel>
                            <TextBlock Text="ExampleFriend" FontSize="9"></TextBlock>
                            <TextBlock Text="Away" FontSize="7" Foreground="orange"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Image Source="/PFPs/Schlep_profile_picture.jpg" MaxHeight="30" MaxWidth="30"/>
                        <StackPanel>
                            <TextBlock Text="ExampleFriend" FontSize="9"></TextBlock>
                            <TextBlock Text="Requesting Resources" FontSize="7" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="2" Grid.RowSpan="2">
            <TextBlock Text="Daily Login: 1. day"></TextBlock>
            <TextBlock Name="DailyRewardTB" Text="Gains a lvl 1 universal food pellet" TextWrapping="Wrap" MaxHeight="50"></TextBlock><!--Might have to set a char limit in c#-->
            <Button Content="Claimed" Background="Gray" Width="50" IsEnabled="True"></Button>
        </StackPanel>

    </Grid>
</Window>
